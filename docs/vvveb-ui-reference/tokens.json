{
  "$schema": "Vvveb UI design tokens — extracted from references/VvvebJs/scss/_builder.scss, editor.scss, and Bootstrap 5 variables. Apache-2.0 source: https://github.com/givanz/VvvebJs",
  "captureViewport": {
    "width": 1440,
    "height": 900,
    "breakpoint": "xl",
    "note": "At 1440px width, CSS media query min-width: 1280px applies — panel widths are fixed 300px (not vw)."
  },
  "layout": {
    "topbarHeight": "35px",
    "bottomPanelHeight": "35px",
    "leftPanelWidth": "300px",
    "rightPanelWidth": "300px",
    "leftPanelWidthByBreakpoint": {
      "sm": "25vw",
      "md": "25vw",
      "lg": "250px",
      "xl": "300px",
      "min1600": "300px",
      "min2000": "300px"
    },
    "rightPanelWidthByBreakpoint": {
      "sm": "25vw",
      "md": "25vw",
      "lg": "250px",
      "xl": "300px",
      "min1600": "300px",
      "min2000": "300px"
    },
    "canvasMargin": "0px",
    "fileManagerHeight": "250px",
    "dragItemsTabsHeight": "40px",
    "panelBg": "var(--bs-body-bg)",
    "panelBgLight": "#ffffff",
    "panelBgDark": "#212529",
    "panelBorder": "1px solid var(--bs-border-color)",
    "panelBorderLight": "#dfdfdf",
    "panelBorderDark": "#444444",
    "rightPanelGradient": "linear-gradient(to right, var(--bs-body-bg) 85%, #fafbfc 100%)",
    "canvasBg": "var(--bs-secondary-bg)",
    "canvasBgLight": "#e9ecef",
    "canvasBgDark": "#343a40",
    "bottomPanelTabsBg": "rgba(var(--bs-body-color-rgb), 0.1)",
    "zIndex": {
      "sidePanels": 10,
      "bottomPanel": 100,
      "iframeLayer": "auto",
      "addSectionBox": 101,
      "treeList": 100,
      "dragClone": 100
    }
  },
  "typography": {
    "fontFamily": "\"Helvetica Neue\", Helvetica, -apple-system, Arial, \"Lucida Grande\", system-ui, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
    "fontSizeBase": "16px",
    "btnFontSize": "14px",
    "modalFontSize": "0.875rem",
    "panelTabIconSize": "1rem",
    "panelTabLabelSize": "0.8rem",
    "elementsTabIconSize": "1.4rem",
    "breadcrumbFontSize": "12px",
    "treeListHeaderFontSize": "12px"
  },
  "controls": {
    "inputPaddingY": "0.4rem",
    "inputPaddingX": "0.5rem",
    "inputHeight": "auto",
    "fontSize": "12px",
    "labelFontSize": "11px",
    "labelFontWeight": "500",
    "labelColor": "var(--bs-secondary-color)",
    "labelColorLight": "#6c757d",
    "radius": "3px",
    "formSelectIndicatorSize": "10px 12px",
    "searchInputFontSize": "12px",
    "searchPlaceholderFontSize": "0.75rem",
    "searchFocusBorderColor": "#80bdff",
    "btnGroupSmFontSize": "12px",
    "btnXsFontSize": "0.75rem",
    "colorInputSize": "24px",
    "toggleWidth": "65px",
    "toggleHeight": "20px",
    "toggleSwitchSize": "18px",
    "toggleTransition": "0.3s ease-in 0s"
  },
  "palette": {
    "componentTileWidth": "var(--builder-component-list-element-width)",
    "componentTileWidthXl": "44%",
    "componentTileMinWidth": "80px",
    "componentTileHeight": "80px",
    "componentTileFontSize": "11px",
    "componentTileBorderRadius": "3px",
    "componentTileBorder": "1px solid rgba(var(--bs-secondary-rgb), 0.25)",
    "componentTilePadding": "50px 5px 7px 5px",
    "componentTileIconBgSize": "auto 42px",
    "blockTileWidth": "42%",
    "blockTileMinHeight": "100px",
    "blockTileFontSize": "11px",
    "blockTileNameFontSize": "12px",
    "blockTileBorderRadius": "0px",
    "sectionGroupHeaderFontSize": "11px",
    "sectionGroupHeaderLineHeight": "28px",
    "sectionGroupHeaderPadding": "0.5rem 1.8rem",
    "hoverBorderColor": "var(--bs-link-color)",
    "hoverBoxShadow": "0px 0px 1px 0px var(--bs-primary)",
    "hoverBg": "rgba(var(--bs-primary-rgb), 0.05)",
    "activeTabIconBg": "rgba(var(--bs-primary-rgb), 0.08)",
    "activeTabIconColor": "var(--bs-link-hover-color)",
    "tabIconHoverBorder": "1px solid rgba(var(--bs-link-color-rgb), 0.2)",
    "cursor": "grab"
  },
  "canvas": {
    "selectOutline": "1px solid var(--bs-primary)",
    "selectOutlineColor": "#0d6efd",
    "selectBg": "rgba(var(--bs-primary-rgb), 0.1)",
    "selectPaddingInlineEdit": "10px",
    "hoverOutline": "1px solid var(--bs-primary)",
    "hoverOutlineDragging": "1px dashed #0d6efd",
    "hoverTransition": "all 0.05s",
    "dropHighlightOutline": "2px solid var(--bs-primary)",
    "dropHighlightRadius": "4px",
    "dropHighlightTransition": "all 0.3s",
    "dragPlaceholder": "background:limegreen; width:100%; height:3px; border:1px solid limegreen; box-shadow:0px 0px 2px 1px rgba(0,0,0,0.14)",
    "dragCloneBorder": "1px solid rgba(var(--bs-body-color-rgb), 0.15)",
    "dragCloneRadius": "4px",
    "dragCloneBg": "rgba(var(--bs-body-bg-rgb), 0.5)",
    "draggedElementOpacity": "0.15",
    "toolbarBg": "var(--bs-primary)",
    "toolbarBgHex": "#0d6efd",
    "toolbarColor": "var(--bs-light)",
    "toolbarPosition": "top: -25px; right: -1px",
    "toolbarBorderRadius": "3px 3px 0px 0px",
    "toolbarIconFontSize": "16px",
    "toolbarIconPadding": "2px 5px",
    "toolbarHoverBg": "rgba(var(--bs-body-color-rgb), 0.3)",
    "highlightNameBg": "var(--bs-primary)",
    "highlightNameColor": "var(--bs-white)",
    "highlightNameFontSize": "12px",
    "highlightNameTypeFontSize": "10px",
    "highlightNamePadding": "2px 5px",
    "highlightNameBorderRadius": "3px 3px 0px 0px",
    "textEditOutline": "1px solid rgba(var(--bs-body-color-rgb), 0.2)",
    "textEditOutlineStyle": "dashed",
    "textEditBorderRadius": "0 0 3px 3px",
    "resizeHandleSize": "10px",
    "resizeHandleBorder": "2px solid var(--bs-primary)",
    "resizeHandleBg": "rgba(var(--bs-primary-rgb), 0.1)",
    "resizeHandleMargin": "-5px",
    "iframeWrapperTransition": "transform 1s ease 0s, width 1s ease 0s, left 1s ease 0s, height 1s ease 0s",
    "responsiveIframeWidth": "767px",
    "addSectionBtnSize": "32px",
    "addSectionBtnFontSize": "18px",
    "addSectionBtnRadius": "24px"
  },
  "styleManager": {
    "tabContentPadding": "0.5rem 0",
    "sectionHeaderFontSize": "11px",
    "sectionHeaderFontWeight": "500",
    "sectionHeaderLineHeight": "32px",
    "sectionHeaderPadding": "0.3rem 0.8rem",
    "sectionHeaderBorderTop": "1px solid var(--bs-border-color)",
    "sectionCollapseTransition": "height, opacity 0.5s",
    "headerArrowPadding": "0.3rem 0.7rem",
    "navTabPadding": "0.5rem 0",
    "navTabColor": "var(--bs-secondary-color)",
    "navItemBg": "rgba(var(--bs-body-color-rgb), 0.025)",
    "propertyRowMargin": "mb-2"
  },
  "layers": {
    "treeListWidth": "250px",
    "treeListMinWidth": "250px",
    "treeListHeight": "500px",
    "treeListMinHeight": "100px",
    "treeListLeftPanelHeight": "300px",
    "treeListHeaderHeight": "30px",
    "treeListBorder": "1px solid rgba(var(--bs-body-color-rgb), 0.15)",
    "treeListBoxShadow": "0px 1px 5px 0px rgba(var(--bs-body-color-rgb), 0.05)",
    "treeListBorderRadius": "2px",
    "activeNodeBorder": "1px solid rgba(var(--bs-primary-rgb), 0.15)",
    "activeNodeBg": "rgba(var(--bs-primary-rgb), 0.05)",
    "sectionItemBorderRadius": "3px",
    "sectionItemPadding": "0.3rem 0.5rem 0.3rem 1.4rem",
    "sectionDragOverBorder": "2px dashed var(--bs-link-color)",
    "sectionDragOverRadius": "5px",
    "handleColor": "#bbbbbb"
  },
  "topbar": {
    "btnLightPadding": "0.25rem 0.5rem",
    "btnLightLineHeight": "1.8",
    "btnLightActiveBg": "rgba(var(--bs-primary-rgb), 0.08)",
    "btnLightHoverBg": "var(--bs-primary-bg-subtle)",
    "btnPrimaryBg": "#0030C0",
    "btnPrimaryPaddingX": "1.2rem",
    "saveBtnFontSize": "1rem",
    "saveBtnBorderRight": "2px solid rgba(var(--bs-body-color-rgb), 0.2)",
    "menuToggleIconSize": "15px",
    "previewMode": "hides #left-panel, #right-panel; canvas full width; toggles #iframe-layer pointer-events"
  },
  "colors": {
    "primary": "#0d6efd",
    "primaryButtonOverride": "#0030C0",
    "link": "#0d6efd",
    "secondary": "#6c757d",
    "success": "#198754",
    "danger": "#dc3545",
    "bodyBgLight": "#ffffff",
    "bodyBgDark": "#212529",
    "bodyColorLight": "#212529",
    "bodyColorDark": "#dee2e6",
    "borderLight": "#dfdfdf",
    "borderDark": "#444444",
    "toggleOffBg": "#999999"
  },
  "scrollbar": {
    "width": "0.5rem",
    "trackBg": "rgba(var(--bs-body-color-rgb), 0.05)",
    "thumbBg": "rgba(var(--bs-body-color-rgb), 0.15)",
    "thumbRadius": "10px",
    "firefoxWidth": "thin"
  },
  "transitions": {
    "highlightBox": "0.05s",
    "dropHighlightBox": "0.3s",
    "rightPanelMargin": "0.1s linear",
    "sectionCollapse": "0.5s",
    "popupAnimation": "0.1s cubic-bezier(0, 0, .2, 1)",
    "hintTooltip": "0.3s ease"
  },
  "breakpoints": {
    "sm": "575.98px",
    "md": "767.98px",
    "lg": "991.98px",
    "xl": "1199.98px",
    "xxl": "1399.98px"
  }
}
